# Rinominare questo file in .env.local

DATABASE_URL="file:./dev.db"

# --- AI PROVIDER ---
# Valori ammessi: "openai" | "gemini" | "mock"
# Se vuota o mancante la chiave corrispondente, l'app usa automaticamente "mock"
AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- MAPPE ---
NEXT_PUBLIC_MAPS_PROVIDER=placeholder
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=

# --- FUTURI SERVIZI (predisposti, non richiesti per l'MVP) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BOOKING_API_KEY=
FLIGHT_API_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
