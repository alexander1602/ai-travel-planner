# Rinominare questo file in .env.local

DATABASE_URL="file:./dev.db"

# --- AI PROVIDER ---
# Valori ammessi: "openai" | "gemini" | "mock"
# Se vuota o mancante la chiave corrispondente, l'app usa automaticamente "mock"
AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite


# --- FLIGHTS PROVIDER ---
# Valori ammessi: "skyscanner" | "mock"
FLIGHT_PROVIDER=mock
SKYSCANNER_API_KEY=
SKYSCANNER_API_HOST=skyscanner44.p.rapidapi.com

# --- FUTURI SERVIZI (predisposti, non richiesti per l'MVP) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BOOKING_API_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
